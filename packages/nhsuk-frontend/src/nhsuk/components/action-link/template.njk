{% from "nhsuk/components/link/macro.njk" import link as nhsukLink %}
{% from "nhsuk/macros/content.njk" import nhsukContent %}
{% from "nhsuk/macros/icon.njk" import nhsukIcon %}

{%- set content = {
  text: params.text,
  html: params.html
} %}

{%- set innerHtml %}
{{ nhsukIcon("arrow-right-circle") | trim }}
<span class="nhsuk-action-link__text">
{% if caller %}
  {%- set outerCaller = caller %}
  {%- call nhsukContent(content) %}
    {{- outerCaller() }}
  {%- endcall %}
{% else %}
  {{ nhsukContent(content) | trim | indent(2) }}
{% endif %}
</span>
{%- endset -%}

{{ nhsukLink({
  id: params.id,
  html: innerHtml,
  href: params.href | default("#"),
  type: params.type,
  className: "nhsuk-action-link",
  classes: classNames,
  attributes: params.attributes,
  element: params.element,
  variant: params.variant
}) | trim }}
